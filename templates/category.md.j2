  - toc
---

# {{ category_title }}

<script>
(function () {
  function openQuestionFromHash() {
    const hash = window.location.hash;
    if (!hash || hash.length <= 1) return;

    const anchor = document.querySelector(hash);
    if (!anchor) return;

    let node = anchor.nextElementSibling;
    while (node) {
      if (node.tagName === 'DETAILS') {
        node.open = true;
        anchor.scrollIntoView({ behavior: 'auto', block: 'start' });
        return;
      }
      node = node.nextElementSibling;
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', openQuestionFromHash);
  } else {
    openQuestionFromHash();
  }

  window.addEventListener('hashchange', openQuestionFromHash);
})();
</script>

{% for q in questions %}

---

<div id="{{ q.id }}"></div>

## {{ q.title }}

{% if q.difficulty or q.tags %}
<div class="question-meta">
  {% if q.difficulty %}
  <span class="question-badge question-badge--difficulty question-badge--{{ q.difficulty | lower }}">{{ q.difficulty }}</span>
  {% endif %}
  {% for tag in q.tags %}
  <span class="question-badge question-badge--tag">{{ tag }}</span>
  {% endfor %}
</div>
{% endif %}

??? question "View Answer"

    {{ q.standard_answer | indent(4) }}

    {% if q.deep_dive %}
    <a class="question-dive-link" href="{{ q.deep_dive }}#{{ q.id }}">🚀 See Full Deep Dive</a>
    {% endif %}

{% endfor %}